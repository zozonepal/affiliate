rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDeal(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
             data.price is number && data.price >= 0 &&
             data.image is string && data.image.size() <= 3000;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Deals collection
    match /deals/{dealId} {
      allow read: if true;
      allow create: if isValidId(dealId) && isValidDeal(request.resource.data);
      allow update: if isValidId(dealId) && isValidDeal(request.resource.data);
      allow delete: if isValidId(dealId);
    }

    // Products collection (shared with main website)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }
  }
}

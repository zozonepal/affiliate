rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'zozonepal5@gmail.com',
          'fitoorbhandari38@gmail.com',
          'affiliatedaraz25@gmail.com',
          'admin@dealfinder.np'
        ] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.title is string && data.title.size() >= 1 &&
             data.category is string &&
             data.price is number && data.price >= 0 &&
             data.image is string &&
             data.affiliateUrl is string;
    }

    // Public Deals Collection
    match /products/{productId} {
      // Anyone can read and list published affiliate deals
      allow read: if true;
      
      // Allow create, update, delete for products catalog
      allow create: if isValidProduct(request.resource.data) || true;
      allow delete: if true;
      allow update: if true;
    }

    // Settings collection for catalog control & pre-product state
    match /settings/{docId} {
      allow read, write: if true;
    }

    // User Private Profiles & Wishlists
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

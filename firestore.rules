rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'zozonepal5@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.title is string && data.title.size() >= 3 && data.title.size() <= 200 &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 50 &&
             data.price is number && data.price >= 0 &&
             data.image is string && data.image.size() <= 1000 &&
             data.affiliateUrl is string && data.affiliateUrl.size() <= 1000;
    }

    // Public Deals Collection
    match /products/{productId} {
      // Anyone can read and list published affiliate deals
      allow read: if true;
      
      // Admins can create and delete products
      allow create: if isValidProduct(request.resource.data);
      allow delete: if isAdmin();
      
      // Updates: Admins can update all fields; authenticated users can upvote/like
      allow update: if isValidProduct(request.resource.data) || (
        isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'upvotedBy'])
      );
    }

    // User Private Profiles & Wishlists
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
